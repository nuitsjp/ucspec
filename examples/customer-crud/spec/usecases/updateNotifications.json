{
  "schemaVersion": "1",
  "usecases": {
    "updateNotifications": {
      "name": "顧客情報の更新通知を編集する",
      "package": "settings",
      "actor": "利用者本人",
      "goal": "顧客情報の更新通知を編集し、更新結果を確認する",
      "starts": [
        {
          "state": "notificationSettings"
        },
        {
          "state": "notificationSettings",
          "values": {
            "notificationEnabled": true,
            "notificationDraft": true
          }
        }
      ],
      "end": {
        "or": [
          {
            "eq": [
              {
                "var": "notificationOutcome"
              },
              "updated"
            ]
          },
          {
            "eq": [
              {
                "var": "notificationOutcome"
              },
              "cancelled"
            ]
          }
        ]
      },
      "scope": [
        "editNotification",
        "updateNotification",
        "cancelNotification"
      ],
      "scenarios": {
        "enable": {
          "name": "顧客情報の更新通知を有効にする",
          "goal": "顧客情報の更新通知をメールで受け取る設定に変更する",
          "expectedOutcome": "設定画面に留まり、通知を有効にする設定が更新される",
          "start": {
            "state": "notificationSettings"
          },
          "steps": [
            {
              "transition": "editNotification",
              "input": {
                "enabled": true
              }
            },
            {
              "transition": "updateNotification"
            }
          ],
          "expect": {
            "and": [
              {
                "eq": [
                  {
                    "var": "$state"
                  },
                  "notificationSettings"
                ]
              },
              {
                "eq": [
                  {
                    "var": "notificationEnabled"
                  },
                  true
                ]
              },
              {
                "eq": [
                  {
                    "var": "notificationOutcome"
                  },
                  "updated"
                ]
              }
            ]
          }
        },
        "disable": {
          "name": "顧客情報の更新通知を無効にする",
          "goal": "顧客情報の更新通知をメールで受け取らない設定に変更する",
          "expectedOutcome": "設定画面に留まり、通知を無効にする設定が更新される",
          "start": {
            "state": "notificationSettings",
            "values": {
              "notificationEnabled": true,
              "notificationDraft": true
            }
          },
          "steps": [
            {
              "transition": "editNotification",
              "input": {
                "enabled": false
              }
            },
            {
              "transition": "updateNotification"
            }
          ],
          "expect": {
            "and": [
              {
                "eq": [
                  {
                    "var": "$state"
                  },
                  "notificationSettings"
                ]
              },
              {
                "eq": [
                  {
                    "var": "notificationEnabled"
                  },
                  false
                ]
              },
              {
                "eq": [
                  {
                    "var": "notificationOutcome"
                  },
                  "updated"
                ]
              }
            ]
          }
        },
        "cancel": {
          "name": "顧客情報の更新通知の編集を取り消す",
          "goal": "通知設定の未更新の編集を取り消し、現在の設定を維持する",
          "expectedOutcome": "編集した下書きは破棄され、通知が無効な現在の設定を保って設定画面に留まる",
          "start": {
            "state": "notificationSettings"
          },
          "steps": [
            {
              "transition": "editNotification",
              "input": {
                "enabled": true
              }
            },
            {
              "transition": "cancelNotification"
            }
          ],
          "expect": {
            "and": [
              {
                "eq": [
                  {
                    "var": "$state"
                  },
                  "notificationSettings"
                ]
              },
              {
                "eq": [
                  {
                    "var": "notificationEnabled"
                  },
                  false
                ]
              },
              {
                "eq": [
                  {
                    "var": "notificationDraft"
                  },
                  false
                ]
              },
              {
                "eq": [
                  {
                    "var": "notificationOutcome"
                  },
                  "cancelled"
                ]
              }
            ]
          }
        }
      }
    }
  }
}
