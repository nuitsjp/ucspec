{
  "schemaVersion": "1",
  "usecases": {
    "viewCustomer": {
      "name": "顧客を閲覧する",
      "package": "customerManagement",
      "actor": "利用者",
      "goal": "対象の顧客情報を確認する",
      "starts": [
        {
          "state": "search",
          "values": {
            "role": "editor"
          }
        },
        {
          "state": "search",
          "values": {
            "role": "reader"
          }
        }
      ],
      "end": {
        "or": [
          {
            "eq": [
              {
                "var": "$state"
              },
              "view"
            ]
          },
          {
            "and": [
              {
                "eq": [
                  {
                    "var": "$state"
                  },
                  "search"
                ]
              },
              {
                "eq": [
                  {
                    "var": "outcome"
                  },
                  "empty"
                ]
              }
            ]
          }
        ]
      },
      "scope": [
        "searchCustomers",
        "searchFound",
        "openCustomer",
        "openView",
        "openGone"
      ],
      "scenarios": {
        "editor": {
          "name": "顧客を閲覧する（editor）",
          "goal": "編集権限を持つ利用者が対象顧客の情報を確認する",
          "expectedOutcome": "検索した対象顧客が存在することを再確認し、顧客閲覧画面でその情報を参照できる",
          "start": {
            "state": "search",
            "values": {
              "role": "editor"
            }
          },
          "steps": [
            {
              "transition": "searchCustomers"
            },
            {
              "transition": "searchFound",
              "expect": {
                "and": [
                  {
                    "eq": [
                      {
                        "var": "$state"
                      },
                      "search"
                    ]
                  },
                  {
                    "eq": [
                      {
                        "var": "searched"
                      },
                      true
                    ]
                  },
                  {
                    "eq": [
                      {
                        "var": "exists"
                      },
                      true
                    ]
                  }
                ]
              }
            },
            {
              "transition": "openCustomer",
              "input": {
                "exists": true
              }
            },
            {
              "transition": "openView"
            }
          ],
          "expect": {
            "and": [
              {
                "eq": [
                  {
                    "var": "$state"
                  },
                  "view"
                ]
              },
              {
                "eq": [
                  {
                    "var": "exists"
                  },
                  true
                ]
              }
            ]
          }
        },
        "reader": {
          "name": "顧客を閲覧する（reader）",
          "goal": "閲覧権限の利用者が対象顧客の情報を確認する",
          "expectedOutcome": "閲覧権限の範囲で、存在を再確認した対象顧客の情報を参照できる",
          "start": {
            "state": "search",
            "values": {
              "role": "reader"
            }
          },
          "steps": [
            {
              "transition": "searchCustomers"
            },
            {
              "transition": "searchFound",
              "expect": {
                "and": [
                  {
                    "eq": [
                      {
                        "var": "$state"
                      },
                      "search"
                    ]
                  },
                  {
                    "eq": [
                      {
                        "var": "searched"
                      },
                      true
                    ]
                  },
                  {
                    "eq": [
                      {
                        "var": "exists"
                      },
                      true
                    ]
                  }
                ]
              }
            },
            {
              "transition": "openCustomer",
              "input": {
                "exists": true
              }
            },
            {
              "transition": "openView"
            }
          ],
          "expect": {
            "and": [
              {
                "eq": [
                  {
                    "var": "$state"
                  },
                  "view"
                ]
              },
              {
                "eq": [
                  {
                    "var": "exists"
                  },
                  true
                ]
              }
            ]
          }
        },
        "disappeared": {
          "name": "顧客を閲覧する前に顧客が消失し、再検索してアラートを表示する",
          "goal": "検索後に閲覧対象が消失したことを確認する",
          "expectedOutcome": "消失した顧客の閲覧を開始せず、再検索とアラート表示を行って検索画面に戻る",
          "start": {
            "state": "search",
            "values": {
              "role": "editor"
            }
          },
          "steps": [
            {
              "transition": "searchCustomers"
            },
            {
              "transition": "searchFound"
            },
            {
              "transition": "openCustomer",
              "input": {
                "exists": false
              }
            },
            {
              "transition": "openGone",
              "expect": {
                "and": [
                  {
                    "eq": [
                      {
                        "var": "$state"
                      },
                      "search"
                    ]
                  },
                  {
                    "eq": [
                      {
                        "var": "searched"
                      },
                      true
                    ]
                  },
                  {
                    "eq": [
                      {
                        "var": "searchAlert"
                      },
                      true
                    ]
                  },
                  {
                    "eq": [
                      {
                        "var": "outcome"
                      },
                      "empty"
                    ]
                  }
                ]
              }
            }
          ],
          "expect": {
            "and": [
              {
                "eq": [
                  {
                    "var": "$state"
                  },
                  "search"
                ]
              },
              {
                "eq": [
                  {
                    "var": "searched"
                  },
                  true
                ]
              },
              {
                "eq": [
                  {
                    "var": "searchAlert"
                  },
                  true
                ]
              },
              {
                "eq": [
                  {
                    "var": "outcome"
                  },
                  "empty"
                ]
              },
              {
                "eq": [
                  {
                    "var": "exists"
                  },
                  false
                ]
              }
            ]
          }
        }
      }
    }
  }
}
