{
  "schemaVersion": "1",
  "variables": {
    "searched": {
      "domain": [
        false,
        true
      ],
      "initial": false,
      "description": "検索を実行済みか。結果件数によって検索の制御状態を分けない。"
    },
    "searchAlert": {
      "domain": [
        false,
        true
      ],
      "initial": false,
      "description": "検索結果が0件であることをアラート表示したか。"
    },
    "role": {
      "domain": [
        "reader",
        "editor"
      ],
      "initial": "editor",
      "description": "実行中は変化しない利用者権限"
    },
    "exists": {
      "domain": [
        true,
        false
      ],
      "initial": true,
      "description": "選択対象が存在するか（1件の抽象モデル）"
    },
    "revision": {
      "domain": [
        "original",
        "updated"
      ],
      "initial": "original"
    },
    "outcome": {
      "domain": [
        "none",
        "viewed",
        "updated",
        "deleted",
        "cancelled",
        "denied",
        "empty"
      ],
      "initial": "none"
    },
    "confirmed": {
      "domain": [
        false,
        true
      ],
      "initial": false,
      "description": "削除確認で「はい」を選んだか。分岐後はfalseへ戻す。"
    }
  },
  "screens": {
    "search": {
      "label": "顧客検索",
      "description": "検索条件を常に表示し、検索後は同じ画面の下部に検索結果を表示する。"
    },
    "view": {
      "label": "顧客閲覧"
    },
    "edit": {
      "label": "顧客編集"
    }
  },
  "choices": {
    "searchResult": {
      "label": "検索結果"
    },
    "customerAvailability": {
      "label": "顧客の有無"
    },
    "deleteConfirmation": {
      "label": "削除確認"
    }
  },
  "states": {
    "search": {
      "label": "顧客検索",
      "screen": "search",
      "layoutLayer": 0,
      "events": [
        "search",
        "open",
        "chooseSettings"
      ]
    },
    "view": {
      "label": "顧客閲覧",
      "screen": "view",
      "layoutLayer": 1,
      "events": [
        "edit",
        "requestDelete",
        "back",
        "chooseSettings"
      ]
    },
    "edit": {
      "label": "顧客編集",
      "screen": "edit",
      "layoutLayer": 2,
      "events": [
        "update",
        "cancelEdit",
        "chooseCustomers",
        "chooseSettings"
      ]
    }
  },
  "events": {
    "search": {
      "label": "検索",
      "source": "user",
      "parameters": {}
    },
    "open": {
      "label": "閲覧",
      "source": "user",
      "parameters": {
        "exists": [
          true,
          false
        ]
      },
      "when": {
        "and": [
          {
            "var": "searched"
          },
          {
            "var": "exists"
          }
        ]
      }
    },
    "back": {
      "label": "検索へ戻る",
      "source": "user",
      "parameters": {}
    },
    "edit": {
      "label": "編集",
      "source": "user",
      "parameters": {},
      "when": {
        "and": [
          {
            "condition": "exists"
          },
          {
            "condition": "canEdit"
          }
        ]
      }
    },
    "requestDelete": {
      "label": "削除",
      "source": "user",
      "parameters": {
        "confirmed": [
          true,
          false
        ]
      },
      "when": {
        "and": [
          {
            "condition": "exists"
          },
          {
            "condition": "canEdit"
          }
        ]
      }
    },
    "cancelEdit": {
      "label": "編集取消",
      "source": "user",
      "parameters": {}
    },
    "update": {
      "label": "更新",
      "source": "user",
      "parameters": {
        "valid": [
          true,
          false
        ]
      },
      "when": {
        "param": "valid"
      }
    }
  },
  "conditions": {
    "exists": {
      "eq": [
        {
          "var": "exists"
        },
        true
      ]
    },
    "canEdit": {
      "eq": [
        {
          "var": "role"
        },
        "editor"
      ]
    },
    "deleteConfirmed": {
      "eq": [
        {
          "var": "confirmed"
        },
        true
      ]
    }
  },
  "transitions": {
    "searchCustomers": {
      "defaultVisible": true,
      "from": "search",
      "to": "searchResult",
      "event": "search",
      "action": "顧客を検索する"
    },
    "searchFound": {
      "defaultVisible": true,
      "from": "searchResult",
      "to": "search",
      "action": "一覧を表示",
      "guard": {
        "condition": "exists"
      },
      "guardLabel": "1件以上",
      "set": {
        "outcome": "none",
        "searched": true,
        "searchAlert": false
      }
    },
    "searchEmpty": {
      "defaultVisible": true,
      "from": "searchResult",
      "to": "search",
      "action": "アラートを表示",
      "guard": {
        "not": {
          "condition": "exists"
        }
      },
      "guardLabel": "0件",
      "set": {
        "outcome": "empty",
        "searched": true,
        "searchAlert": true
      }
    },
    "openCustomer": {
      "defaultVisible": true,
      "from": "search",
      "to": "customerAvailability",
      "event": "open",
      "action": "",
      "set": {
        "exists": {
          "param": "exists"
        },
        "outcome": "none",
        "searchAlert": false
      }
    },
    "openView": {
      "defaultVisible": true,
      "from": "customerAvailability",
      "to": "view",
      "action": "顧客を表示",
      "guard": {
        "condition": "exists"
      },
      "guardLabel": "顧客あり",
      "set": {
        "outcome": "viewed"
      }
    },
    "openGone": {
      "defaultVisible": true,
      "from": "customerAvailability",
      "to": "search",
      "action": "再検索してアラートを表示",
      "guard": {
        "not": {
          "condition": "exists"
        }
      },
      "guardLabel": "顧客なし",
      "set": {
        "outcome": "empty",
        "searched": true,
        "searchAlert": true
      }
    },
    "backResults": {
      "defaultVisible": true,
      "from": "view",
      "to": "search",
      "event": "back",
      "action": "条件と結果を再表示",
      "set": {
        "outcome": "none"
      },
      "unownedReason": "全体ナビゲーション。横断回帰シナリオで確認する。"
    },
    "openEdit": {
      "defaultVisible": true,
      "from": "view",
      "to": "edit",
      "event": "edit",
      "action": "編集欄を表示",
      "guard": {
        "and": [
          {
            "condition": "exists"
          },
          {
            "condition": "canEdit"
          }
        ]
      },
      "guardLabel": "顧客あり・編集可",
      "set": {
        "outcome": "none"
      }
    },
    "updateCustomer": {
      "defaultVisible": true,
      "from": "edit",
      "to": "view",
      "event": "update",
      "action": "顧客を更新",
      "guard": {
        "and": [
          {
            "condition": "exists"
          },
          {
            "condition": "canEdit"
          }
        ]
      },
      "guardLabel": "顧客あり・編集可",
      "set": {
        "revision": "updated",
        "outcome": "updated"
      }
    },
    "cancelEdit": {
      "defaultVisible": true,
      "from": "edit",
      "to": "view",
      "event": "cancelEdit",
      "action": "編集を破棄",
      "set": {
        "outcome": "cancelled"
      }
    },
    "requestDelete": {
      "defaultVisible": true,
      "from": "view",
      "to": "deleteConfirmation",
      "event": "requestDelete",
      "action": "",
      "set": {
        "confirmed": {
          "param": "confirmed"
        }
      }
    },
    "confirmDelete": {
      "defaultVisible": true,
      "from": "deleteConfirmation",
      "to": "search",
      "action": "削除",
      "guard": {
        "condition": "deleteConfirmed"
      },
      "guardLabel": "はい",
      "set": {
        "searched": false,
        "exists": false,
        "outcome": "deleted",
        "confirmed": false
      }
    },
    "cancelDelete": {
      "defaultVisible": true,
      "from": "deleteConfirmation",
      "to": "view",
      "action": "",
      "guard": {
        "not": {
          "condition": "deleteConfirmed"
        }
      },
      "guardLabel": "いいえ",
      "set": {
        "outcome": "cancelled",
        "confirmed": false
      }
    }
  }
}
