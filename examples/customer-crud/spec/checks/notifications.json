{
  "schemaVersion": "1",
  "properties": {
    "notificationEnablePossible": {
      "kind": "reachable",
      "description": "本人の顧客情報の更新通知を有効にして更新できる。",
      "assert": {
        "and": [
          {
            "eq": [
              {
                "var": "notificationEnabled"
              },
              true
            ]
          },
          {
            "eq": [
              {
                "var": "notificationOutcome"
              },
              "updated"
            ]
          }
        ]
      }
    }
  },
  "regressions": {
    "notificationThenCustomer": {
      "name": "顧客情報の更新通知を更新してから顧客を閲覧する",
      "goal": "通知設定を更新した後に顧客情報を確認する",
      "expectedOutcome": "通知を有効にした設定を維持し、対象顧客を検索して閲覧できる",
      "start": {
        "state": "search"
      },
      "steps": [
        {
          "transition": "openSettings",
          "input": {
            "discard": true
          }
        },
        {
          "transition": "updateNotification",
          "input": {
            "enabled": true
          }
        },
        {
          "transition": "returnSearchFromSettings",
          "input": {
            "discard": true
          }
        },
        {
          "transition": "searchCustomers"
        },
        {
          "transition": "searchFound"
        },
        {
          "transition": "openCustomer",
          "input": {
            "exists": true
          }
        },
        {
          "transition": "openView"
        }
      ],
      "expect": {
        "and": [
          {
            "eq": [
              {
                "var": "$state"
              },
              "view"
            ]
          },
          {
            "eq": [
              {
                "var": "notificationEnabled"
              },
              true
            ]
          },
          {
            "eq": [
              {
                "var": "exists"
              },
              true
            ]
          }
        ]
      }
    }
  }
}
