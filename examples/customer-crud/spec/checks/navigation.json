{
  "schemaVersion": "1",
  "regressions": {
    "customerEditNavigation": {
      "name": "顧客編集中の移動を中止すると入力を保持し、了承すると破棄する",
      "goal": "未更新の顧客編集を保持するか破棄するかを選んで機能を切り替える",
      "expectedOutcome": "移動を中止した間は編集画面と入力を保持し、破棄に同意した場合だけ移動する。顧客の元の情報と検索結果、通知設定は維持される",
      "start": {
        "state": "search"
      },
      "steps": [
        {
          "transition": "searchFound"
        },
        {
          "transition": "openCustomer",
          "input": {
            "exists": true
          }
        },
        {
          "transition": "openView"
        },
        {
          "transition": "openEdit"
        },
        {
          "transition": "keepCustomerEditForSettings",
          "input": {
            "discard": false
          },
          "expect": {
            "and": [
              {
                "eq": [
                  {
                    "var": "$state"
                  },
                  "edit"
                ]
              },
              {
                "eq": [
                  {
                    "var": "revision"
                  },
                  "original"
                ]
              }
            ]
          }
        },
        {
          "transition": "keepCustomerEditForSearch",
          "input": {
            "discard": false
          },
          "expect": {
            "eq": [
              {
                "var": "$state"
              },
              "edit"
            ]
          }
        },
        {
          "transition": "openSettingsFromCustomerEdit",
          "input": {
            "discard": true
          },
          "expect": {
            "and": [
              {
                "eq": [
                  {
                    "var": "$state"
                  },
                  "notificationSettings"
                ]
              },
              {
                "eq": [
                  {
                    "var": "revision"
                  },
                  "original"
                ]
              }
            ]
          }
        },
        {
          "transition": "returnSearchFromSettings",
          "input": {
            "discard": true
          }
        }
      ],
      "expect": {
        "and": [
          {
            "eq": [
              {
                "var": "$state"
              },
              "search"
            ]
          },
          {
            "eq": [
              {
                "var": "searched"
              },
              true
            ]
          },
          {
            "eq": [
              {
                "var": "revision"
              },
              "original"
            ]
          },
          {
            "eq": [
              {
                "var": "notificationEnabled"
              },
              false
            ]
          }
        ]
      }
    },
    "settingsNavigationDiscard": {
      "name": "通知の未更新入力を保持して留まり、了承してから破棄して移動する",
      "goal": "通知設定の未更新の入力を保持するか破棄するかを選んで検索へ戻る",
      "expectedOutcome": "移動を中止すると未更新の入力を保持して設定画面に留まり、破棄に同意すると元の設定を維持して検索画面へ戻る",
      "start": {
        "state": "search"
      },
      "steps": [
        {
          "transition": "openSettingsFromSearch",
          "input": {
            "discard": true
          }
        },
        {
          "transition": "editNotification",
          "input": {
            "enabled": true
          }
        },
        {
          "transition": "keepSettingsForSearch",
          "input": {
            "discard": false
          },
          "expect": {
            "and": [
              {
                "eq": [
                  {
                    "var": "$state"
                  },
                  "notificationSettings"
                ]
              },
              {
                "eq": [
                  {
                    "var": "notificationDraft"
                  },
                  true
                ]
              },
              {
                "eq": [
                  {
                    "var": "notificationEnabled"
                  },
                  false
                ]
              }
            ]
          }
        },
        {
          "transition": "returnSearchFromSettings",
          "input": {
            "discard": true
          }
        }
      ],
      "expect": {
        "and": [
          {
            "eq": [
              {
                "var": "$state"
              },
              "search"
            ]
          },
          {
            "eq": [
              {
                "var": "notificationDraft"
              },
              false
            ]
          },
          {
            "eq": [
              {
                "var": "notificationEnabled"
              },
              false
            ]
          }
        ]
      }
    },
    "viewToSettings": {
      "name": "顧客閲覧から設定へ移動しても顧客と検索結果を保持する",
      "goal": "顧客閲覧と通知設定を切り替えても顧客情報を維持する",
      "expectedOutcome": "設定から検索へ戻っても検索結果と対象顧客が存在し、顧客情報は変更されない",
      "start": {
        "state": "search"
      },
      "steps": [
        {
          "transition": "searchFound"
        },
        {
          "transition": "openCustomer",
          "input": {
            "exists": true
          }
        },
        {
          "transition": "openView"
        },
        {
          "transition": "openSettingsFromView",
          "input": {
            "discard": true
          }
        },
        {
          "transition": "returnSearchFromSettings",
          "input": {
            "discard": true
          }
        }
      ],
      "expect": {
        "and": [
          {
            "eq": [
              {
                "var": "$state"
              },
              "search"
            ]
          },
          {
            "eq": [
              {
                "var": "searched"
              },
              true
            ]
          },
          {
            "eq": [
              {
                "var": "exists"
              },
              true
            ]
          },
          {
            "eq": [
              {
                "var": "revision"
              },
              "original"
            ]
          }
        ]
      }
    },
    "openAfterCustomerDisappears": {
      "name": "検索結果の対象消失時は再検索してアラートを表示する",
      "goal": "検索結果の顧客が閲覧開始前に消失した場合に最新の結果を確認する",
      "expectedOutcome": "顧客閲覧を開始せず再検索し、対象が見つからないことをアラートで確認できる",
      "start": {
        "state": "search"
      },
      "steps": [
        {
          "transition": "searchFound"
        },
        {
          "transition": "openCustomer",
          "input": {
            "exists": false
          }
        },
        {
          "transition": "openGone"
        }
      ],
      "expect": {
        "and": [
          {
            "eq": [
              {
                "var": "$state"
              },
              "search"
            ]
          },
          {
            "eq": [
              {
                "var": "searched"
              },
              true
            ]
          },
          {
            "eq": [
              {
                "var": "searchAlert"
              },
              true
            ]
          },
          {
            "eq": [
              {
                "var": "outcome"
              },
              "empty"
            ]
          },
          {
            "eq": [
              {
                "var": "exists"
              },
              false
            ]
          }
        ]
      }
    }
  },
  "decisions": {}
}
