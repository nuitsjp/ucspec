{
  "schemaVersion": "1",
  "usecases": {
    "viewCustomer": {
      "name": "顧客を閲覧する",
      "package": "customerManagement",
      "actor": "担当者",
      "goal": "対象の顧客情報を確認する",
      "starts": [
        "顧客検索"
      ],
      "ends": [
        "顧客検索:閲覧"
      ],
      "scope": [
        "顧客検索:検索",
        "顧客検索:閲覧"
      ],
      "scenarios": {
        "view": {
          "name": "顧客を閲覧する",
          "goal": "検索した対象顧客の情報を確認する",
          "expectedOutcome": "検索した対象顧客が存在することを再確認し、顧客閲覧画面でその情報を参照できる",
          "start": "顧客検索",
          "steps": [
            {
              "event": "検索",
              "branches": [
                "1件以上"
              ]
            },
            {
              "event": "閲覧",
              "branches": [
                "顧客あり"
              ]
            }
          ]
        },
        "disappeared": {
          "name": "顧客を閲覧する前に顧客が消失する",
          "goal": "検索後に閲覧対象が消失したことを確認する",
          "expectedOutcome": "消失した顧客の閲覧を開始せず、アラートを表示して検索画面に留まる",
          "start": "顧客検索",
          "steps": [
            {
              "event": "検索",
              "branches": [
                "1件以上"
              ]
            },
            {
              "event": "閲覧",
              "branches": [
                "顧客なし"
              ]
            }
          ]
        },
        "retry": {
          "name": "0件の後に再検索して閲覧する",
          "goal": "検索条件を見直して目的の顧客を見つけ、その情報を確認する",
          "expectedOutcome": "最初の検索で0件アラートを確認した後、再検索で見つかった顧客の情報を顧客閲覧画面で参照できる",
          "start": "顧客検索",
          "steps": [
            {
              "event": "検索",
              "branches": [
                "0件"
              ]
            },
            {
              "event": "検索",
              "branches": [
                "1件以上"
              ]
            },
            {
              "event": "閲覧",
              "branches": [
                "顧客あり"
              ]
            }
          ]
        }
      }
    }
  }
}
