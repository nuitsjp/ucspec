{
  "schemaVersion": "1",
  "usecases": {
    "editCustomer": {
      "name": "顧客を編集する",
      "package": "customerManagement",
      "actor": "編集担当者",
      "goal": "顧客情報を編集し、更新結果を確認する",
      "starts": [
        "顧客閲覧"
      ],
      "ends": [
        "顧客編集:更新",
        "顧客編集:取消"
      ],
      "scope": [
        "顧客閲覧:編集",
        "顧客編集:更新",
        "顧客編集:取消"
      ],
      "scenarios": {
        "update": {
          "name": "正常に更新する",
          "goal": "顧客情報を最新の内容へ編集して更新する",
          "expectedOutcome": "顧客情報が更新され、顧客閲覧画面で更新結果を確認できる",
          "start": "顧客閲覧",
          "steps": [
            {
              "event": "編集"
            },
            {
              "event": "更新",
              "branches": [
                "顧客あり"
              ]
            }
          ]
        },
        "cancel": {
          "name": "編集を中止する",
          "goal": "顧客情報の編集を取りやめ、元の情報を維持する",
          "expectedOutcome": "編集内容は更新されず、元の顧客情報を保ったまま顧客閲覧画面へ戻る",
          "start": "顧客閲覧",
          "steps": [
            {
              "event": "編集"
            },
            {
              "event": "取消"
            }
          ]
        },
        "deletedBeforeUpdate": {
          "name": "更新前に顧客が削除されている",
          "goal": "編集中に削除された顧客を誤って更新しない",
          "expectedOutcome": "更新時に顧客の消失を確認してアラートを表示し、顧客検索画面へ戻る",
          "start": "顧客閲覧",
          "steps": [
            {
              "event": "編集"
            },
            {
              "event": "更新",
              "branches": [
                "顧客なし"
              ]
            }
          ]
        }
      }
    }
  }
}
