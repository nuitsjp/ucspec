{
  "schemaVersion": "1",
  "usecases": {
    "deleteCustomer": {
      "name": "顧客を削除する",
      "package": "customerManagement",
      "actor": "編集担当者",
      "goal": "顧客の削除を確認して実行する",
      "starts": [
        "顧客閲覧"
      ],
      "ends": [
        "顧客閲覧:削除"
      ],
      "scope": [
        "顧客閲覧:削除"
      ],
      "scenarios": {
        "delete": {
          "name": "削除を確定する",
          "goal": "不要となった顧客情報を確認して削除する",
          "expectedOutcome": "削除を確定した対象顧客が管理対象から除かれ、顧客検索画面へ戻る",
          "start": "顧客閲覧",
          "steps": [
            {
              "event": "削除",
              "branches": [
                "はい"
              ]
            }
          ]
        },
        "cancel": {
          "name": "削除を中止する",
          "goal": "顧客情報の削除を取りやめ、管理対象として残す",
          "expectedOutcome": "削除は実行されず、顧客閲覧画面で対象顧客の情報が維持される",
          "start": "顧客閲覧",
          "steps": [
            {
              "event": "削除",
              "branches": [
                "いいえ"
              ]
            }
          ]
        }
      }
    }
  }
}
