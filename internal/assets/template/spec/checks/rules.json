{
  "schemaVersion": "1",
  "properties": {
    "editableTarget": {
      "kind": "invariant",
      "description": "編集状態では、対象が存在し編集権限がある。",
      "assert": {
        "or": [
          {
            "not": {
              "inState": "edit"
            }
          },
          {
            "and": [
              {
                "eq": [
                  {
                    "var": "exists"
                  },
                  true
                ]
              },
              {
                "eq": [
                  {
                    "var": "role"
                  },
                  "editor"
                ]
              }
            ]
          }
        ]
      }
    },
    "noResurrection": {
      "kind": "invariant",
      "description": "削除済みの対象が閲覧・編集・削除画面に残らない。",
      "assert": {
        "or": [
          {
            "eq": [
              {
                "var": "exists"
              },
              true
            ]
          },
          {
            "not": {
              "or": [
                {
                  "inState": "view"
                },
                {
                  "inState": "edit"
                }
              ]
            }
          }
        ]
      }
    },
    "updatePossible": {
      "kind": "reachable",
      "description": "更新成功に到達する経路が存在する。",
      "assert": {
        "eq": [
          {
            "var": "outcome"
          },
          "updated"
        ]
      }
    },
    "deletePossible": {
      "kind": "reachable",
      "description": "削除成功に到達する経路が存在する。",
      "assert": {
        "eq": [
          {
            "var": "outcome"
          },
          "deleted"
        ]
      }
    },
    "canReturn": {
      "kind": "recoverable",
      "description": "各到達状態から検索画面へ戻る経路がある（必ず終了する保証ではない）。",
      "assert": {
        "inState": "search"
      }
    },
    "searchAlertMatchesResult": {
      "kind": "invariant",
      "description": "検索実行後に検索画面で表示するアラートは、検索結果が0件の場合だけである。",
      "assert": {
        "or": [
          {
            "not": {
              "and": [
                {
                  "eq": [
                    {
                      "var": "$state"
                    },
                    "search"
                  ]
                },
                {
                  "eq": [
                    {
                      "var": "searched"
                    },
                    true
                  ]
                }
              ]
            }
          },
          {
            "eq": [
              {
                "var": "searchAlert"
              },
              {
                "not": {
                  "var": "exists"
                }
              }
            ]
          }
        ]
      }
    },
    "deletionRequiresPermission": {
      "kind": "invariant",
      "description": "削除が確定した結果には編集権限が必要である。",
      "assert": {
        "or": [
          {
            "not": {
              "eq": [
                {
                  "var": "outcome"
                },
                "deleted"
              ]
            }
          },
          {
            "eq": [
              {
                "var": "role"
              },
              "editor"
            ]
          }
        ]
      }
    }
  },
  "regressions": {
    "deleteThenSearch": {
      "name": "削除後に検索しても対象は復活しない",
      "goal": "削除した顧客が再検索しても管理対象へ戻らないことを確認する",
      "expectedOutcome": "削除後に検索しても対象顧客は見つからず、削除状態を維持して0件アラートを表示する",
      "start": {
        "state": "search"
      },
      "steps": [
        {
          "transition": "searchCustomers"
        },
        {
          "transition": "searchFound"
        },
        {
          "transition": "openCustomer",
          "input": {
            "exists": true
          }
        },
        {
          "transition": "openView"
        },
        {
          "transition": "requestDelete",
          "input": {
            "confirmed": true
          }
        },
        {
          "transition": "confirmDelete"
        },
        {
          "transition": "searchCustomers"
        },
        {
          "transition": "searchEmpty"
        }
      ],
      "expect": {
        "and": [
          {
            "eq": [
              {
                "var": "exists"
              },
              false
            ]
          },
          {
            "eq": [
              {
                "var": "$state"
              },
              "search"
            ]
          },
          {
            "eq": [
              {
                "var": "outcome"
              },
              "empty"
            ]
          },
          {
            "eq": [
              {
                "var": "searchAlert"
              },
              true
            ]
          }
        ]
      }
    },
    "readerCannotEdit": {
      "name": "閲覧者は編集開始遷移を実行できない",
      "goal": "閲覧者が編集開始を直接要求しても顧客情報を保護する",
      "expectedOutcome": "編集開始は拒否され、顧客閲覧画面と元の顧客情報が維持される",
      "start": {
        "state": "search",
        "values": {
          "role": "reader"
        }
      },
      "steps": [
        {
          "transition": "searchCustomers"
        },
        {
          "transition": "searchFound"
        },
        {
          "transition": "openCustomer",
          "input": {
            "exists": true
          }
        },
        {
          "transition": "openView"
        },
        {
          "transition": "openEdit",
          "reject": true
        }
      ],
      "expect": {
        "and": [
          {
            "eq": [
              {
                "var": "$state"
              },
              "view"
            ]
          },
          {
            "eq": [
              {
                "var": "revision"
              },
              "original"
            ]
          }
        ]
      }
    },
    "invalidInputCannotUpdate": {
      "name": "入力不備では更新せず、修正後に更新する",
      "goal": "入力の不備を修正してから正しい顧客情報へ更新する",
      "expectedOutcome": "入力不備の間は編集画面に留まって元の顧客情報を保持し、修正後の有効な入力で更新して閲覧画面へ戻る",
      "start": {
        "state": "search",
        "values": {
          "role": "editor"
        }
      },
      "steps": [
        {
          "transition": "searchCustomers"
        },
        {
          "transition": "searchFound"
        },
        {
          "transition": "openCustomer",
          "input": {
            "exists": true
          }
        },
        {
          "transition": "openView"
        },
        {
          "transition": "openEdit",
          "expect": {
            "and": [
              {
                "inState": "edit"
              },
              {
                "eq": [
                  {
                    "var": "$state"
                  },
                  "edit"
                ]
              }
            ]
          }
        },
        {
          "transition": "updateCustomer",
          "input": {
            "valid": false,
            "exists": true
          },
          "reject": true,
          "expect": {
            "and": [
              {
                "eq": [
                  {
                    "var": "$state"
                  },
                  "edit"
                ]
              },
              {
                "eq": [
                  {
                    "var": "revision"
                  },
                  "original"
                ]
              },
              {
                "eq": [
                  {
                    "var": "outcome"
                  },
                  "none"
                ]
              }
            ]
          }
        },
        {
          "transition": "updateCustomer",
          "input": {
            "valid": true,
            "exists": true
          }
        },
        {
          "transition": "openView",
          "expect": {
            "and": [
              {
                "eq": [
                  {
                    "var": "$state"
                  },
                  "view"
                ]
              },
              {
                "eq": [
                  {
                    "var": "revision"
                  },
                  "updated"
                ]
              }
            ]
          }
        }
      ],
      "expect": {
        "and": [
          {
            "eq": [
              {
                "var": "$state"
              },
              "view"
            ]
          },
          {
            "eq": [
              {
                "var": "revision"
              },
              "updated"
            ]
          },
          {
            "eq": [
              {
                "var": "outcome"
              },
              "updated"
            ]
          }
        ]
      }
    },
    "editCustomer_denied": {
      "name": "閲覧権限では編集できない",
      "goal": "閲覧権限の利用者による顧客情報の編集を防ぐ",
      "expectedOutcome": "編集開始イベントを受理せず、顧客閲覧画面、対象顧客、元の情報と閲覧結果を保持する",
      "start": {
        "state": "search",
        "values": {
          "role": "reader"
        }
      },
      "steps": [
        {
          "transition": "searchCustomers"
        },
        {
          "transition": "searchFound"
        },
        {
          "transition": "openCustomer",
          "input": {
            "exists": true
          }
        },
        {
          "transition": "openView"
        },
        {
          "transition": "openEdit",
          "reject": true
        }
      ],
      "expect": {
        "and": [
          {
            "eq": [
              {
                "var": "$state"
              },
              "view"
            ]
          },
          {
            "eq": [
              {
                "var": "exists"
              },
              true
            ]
          },
          {
            "eq": [
              {
                "var": "revision"
              },
              "original"
            ]
          },
          {
            "eq": [
              {
                "var": "outcome"
              },
              "viewed"
            ]
          }
        ]
      }
    },
    "deleteCustomer_denied": {
      "name": "閲覧権限では削除できない",
      "goal": "閲覧権限の利用者による顧客情報の削除を防ぐ",
      "expectedOutcome": "削除イベントを受理せず、顧客閲覧画面、対象顧客、元の情報と閲覧結果を保持する",
      "start": {
        "state": "search",
        "values": {
          "role": "reader"
        }
      },
      "steps": [
        {
          "transition": "searchCustomers"
        },
        {
          "transition": "searchFound"
        },
        {
          "transition": "openCustomer",
          "input": {
            "exists": true
          }
        },
        {
          "transition": "openView"
        },
        {
          "transition": "requestDelete",
          "input": {
            "confirmed": true
          },
          "reject": true
        }
      ],
      "expect": {
        "and": [
          {
            "eq": [
              {
                "var": "$state"
              },
              "view"
            ]
          },
          {
            "eq": [
              {
                "var": "exists"
              },
              true
            ]
          },
          {
            "eq": [
              {
                "var": "revision"
              },
              "original"
            ]
          },
          {
            "eq": [
              {
                "var": "outcome"
              },
              "viewed"
            ]
          }
        ]
      }
    },
    "deleteCustomer_deniedDecline": {
      "name": "閲覧権限では確認を断っても削除されない",
      "goal": "削除確認の入力にかかわらず閲覧権限での削除操作を防ぐ",
      "expectedOutcome": "否定の確認入力を渡しても削除イベントを受理せず、顧客閲覧画面と対象顧客の情報を保持する",
      "start": {
        "state": "search",
        "values": {
          "role": "reader"
        }
      },
      "steps": [
        {
          "transition": "searchCustomers"
        },
        {
          "transition": "searchFound"
        },
        {
          "transition": "openCustomer",
          "input": {
            "exists": true
          }
        },
        {
          "transition": "openView"
        },
        {
          "transition": "requestDelete",
          "input": {
            "confirmed": false
          },
          "reject": true
        }
      ],
      "expect": {
        "and": [
          {
            "eq": [
              {
                "var": "$state"
              },
              "view"
            ]
          },
          {
            "eq": [
              {
                "var": "exists"
              },
              true
            ]
          },
          {
            "eq": [
              {
                "var": "revision"
              },
              "original"
            ]
          },
          {
            "eq": [
              {
                "var": "outcome"
              },
              "viewed"
            ]
          }
        ]
      }
    }
  },
  "decisions": {
    "searchCustomers": {
      "state": "search",
      "event": "search",
      "cases": [
        {
          "values": {
            "exists": true
          },
          "enabled": [
            "searchCustomers"
          ]
        },
        {
          "values": {
            "exists": false
          },
          "enabled": [
            "searchCustomers"
          ]
        }
      ]
    },
    "searchResult": {
      "state": "searchResult",
      "cases": [
        {
          "values": {
            "exists": true
          },
          "enabled": [
            "searchFound"
          ]
        },
        {
          "values": {
            "exists": false
          },
          "enabled": [
            "searchEmpty"
          ]
        }
      ]
    },
    "openCustomer": {
      "state": "search",
      "event": "open",
      "cases": [
        {
          "values": {
            "searched": true,
            "exists": true
          },
          "input": {
            "exists": true
          },
          "enabled": [
            "openCustomer"
          ]
        },
        {
          "values": {
            "searched": true,
            "exists": true
          },
          "input": {
            "exists": false
          },
          "enabled": [
            "openCustomer"
          ]
        }
      ]
    },
    "customerAvailability": {
      "state": "customerAvailability",
      "cases": [
        {
          "values": {
            "exists": true
          },
          "enabled": [
            "openView"
          ]
        },
        {
          "values": {
            "exists": false
          },
          "enabled": [
            "openGone"
          ]
        }
      ]
    },
    "updateValidation": {
      "state": "edit",
      "event": "update",
      "cases": [
        {
          "values": {
            "exists": true,
            "role": "editor"
          },
          "input": {
            "valid": true,
            "exists": true
          },
          "enabled": [
            "updateCustomer"
          ]
        },
        {
          "values": {
            "exists": true,
            "role": "editor"
          },
          "input": {
            "valid": true,
            "exists": false
          },
          "enabled": [
            "updateCustomer"
          ]
        },
        {
          "values": {
            "exists": true,
            "role": "editor"
          },
          "input": {
            "valid": false,
            "exists": true
          },
          "enabled": []
        },
        {
          "values": {
            "exists": true,
            "role": "editor"
          },
          "input": {
            "valid": false,
            "exists": false
          },
          "enabled": []
        }
      ]
    },
    "requestDelete": {
      "state": "view",
      "event": "requestDelete",
      "cases": [
        {
          "values": {
            "role": "editor",
            "exists": true
          },
          "input": {
            "confirmed": true
          },
          "enabled": [
            "requestDelete"
          ]
        },
        {
          "values": {
            "role": "editor",
            "exists": true
          },
          "input": {
            "confirmed": false
          },
          "enabled": [
            "requestDelete"
          ]
        },
        {
          "values": {
            "role": "editor",
            "exists": false
          },
          "input": {
            "confirmed": true
          },
          "enabled": []
        },
        {
          "values": {
            "role": "editor",
            "exists": false
          },
          "input": {
            "confirmed": false
          },
          "enabled": []
        },
        {
          "values": {
            "role": "reader",
            "exists": true
          },
          "input": {
            "confirmed": true
          },
          "enabled": []
        },
        {
          "values": {
            "role": "reader",
            "exists": true
          },
          "input": {
            "confirmed": false
          },
          "enabled": []
        },
        {
          "values": {
            "role": "reader",
            "exists": false
          },
          "input": {
            "confirmed": true
          },
          "enabled": []
        },
        {
          "values": {
            "role": "reader",
            "exists": false
          },
          "input": {
            "confirmed": false
          },
          "enabled": []
        }
      ]
    },
    "deleteConfirmation": {
      "state": "deleteConfirmation",
      "cases": [
        {
          "values": {
            "confirmed": true
          },
          "enabled": [
            "confirmDelete"
          ]
        },
        {
          "values": {
            "confirmed": false
          },
          "enabled": [
            "cancelDelete"
          ]
        }
      ]
    },
    "editAvailability": {
      "state": "view",
      "event": "edit",
      "cases": [
        {
          "values": {
            "role": "editor"
          },
          "enabled": [
            "openEdit"
          ]
        },
        {
          "values": {
            "role": "reader"
          },
          "enabled": []
        }
      ]
    }
  }
}
