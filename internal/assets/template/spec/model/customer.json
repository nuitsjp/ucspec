{
  "schemaVersion": "1",
  "start": {
    "to": "顧客管理"
  },
  "actors": {
    "担当者": {
      "description": "顧客情報を検索・閲覧し、自分の通知設定を更新する社内担当者"
    },
    "編集担当者": {
      "description": "担当者の操作に加えて、顧客情報を編集・削除できる社内担当者"
    }
  },
  "states": {
    "顧客管理": {
      "start": {
        "to": "顧客検索"
      },
      "events": {
        "設定を選択": {
          "actors": ["担当者", "編集担当者"],
          "action": "通知設定を表示する",
          "to": "設定"
        }
      },
      "states": {
        "顧客検索": {
          "layoutLayer": 0,
          "events": {
            "検索": {
              "actors": ["担当者", "編集担当者"],
              "defaultVisible": true,
              "action": "顧客を検索する",
              "decision": {
                "label": "検索結果",
                "branches": {
                  "1件以上": {
                    "action": "一覧を表示する"
                  },
                  "0件": {
                    "action": "アラートを表示する"
                  }
                }
              }
            },
            "閲覧": {
              "actors": ["担当者", "編集担当者"],
              "defaultVisible": true,
              "decision": {
                "label": "顧客の有無",
                "branches": {
                  "顧客あり": {
                    "action": "顧客を表示する",
                    "to": "顧客閲覧"
                  },
                  "顧客なし": {
                    "action": "アラートを表示する"
                  }
                }
              }
            }
          }
        },
        "顧客閲覧": {
          "layoutLayer": 1,
          "events": {
            "検索へ戻る": {
              "actors": ["担当者", "編集担当者"],
              "defaultVisible": true,
              "action": "検索結果を再表示する",
              "to": "顧客検索"
            },
            "編集": {
              "actors": ["編集担当者"],
              "defaultVisible": true,
              "action": "編集欄を表示する",
              "to": "顧客編集"
            },
            "削除": {
              "actors": ["編集担当者"],
              "defaultVisible": true,
              "decision": {
                "label": "削除確認",
                "branches": {
                  "はい": {
                    "action": "顧客を削除する",
                    "to": "顧客検索"
                  },
                  "いいえ": {}
                }
              }
            }
          }
        },
        "顧客編集": {
          "layoutLayer": 2,
          "events": {
            "更新": {
              "actors": ["編集担当者"],
              "defaultVisible": true,
              "action": "顧客を更新する",
              "decision": {
                "label": "顧客の有無",
                "branches": {
                  "顧客あり": {
                    "action": "顧客を表示する",
                    "to": "顧客閲覧"
                  },
                  "顧客なし": {
                    "action": "アラートを表示する",
                    "to": "顧客検索"
                  }
                }
              }
            },
            "取消": {
              "actors": ["編集担当者"],
              "defaultVisible": true,
              "to": "顧客閲覧"
            },
            "設定を選択": {
              "actors": ["編集担当者"],
              "decision": {
                "label": "破棄確認",
                "branches": {
                  "破棄する": {
                    "action": "通知設定を表示する",
                    "to": "設定"
                  },
                  "取り消す": {}
                }
              }
            },
            "顧客管理を選択": {
              "actors": ["編集担当者"],
              "decision": {
                "label": "破棄確認",
                "branches": {
                  "破棄する": {
                    "action": "検索を復元する",
                    "to": "顧客検索"
                  },
                  "取り消す": {}
                }
              }
            }
          }
        }
      }
    }
  }
}
