{
  "schemaVersion": "1",
  "variables": {
    "notificationEnabled": {
      "domain": [
        false,
        true
      ],
      "initial": false,
      "description": "本人の顧客情報の更新通知設定。顧客情報の更新通知を受け取るか。"
    },
    "notificationOutcome": {
      "domain": [
        "none",
        "updated"
      ],
      "initial": "none"
    }
  },
  "screens": {
    "notificationSettings": {
      "label": "通知設定",
      "description": "顧客情報の更新通知を同じ画面で更新する。"
    }
  },
  "states": {
    "settings": {
      "label": "設定",
      "screen": "notificationSettings",
      "events": [],
      "initial": "notificationSettings"
    },
    "notificationSettings": {
      "label": "通知設定",
      "screen": "notificationSettings",
      "parent": "settings",
      "layoutLayer": 0,
      "events": [
        "updateNotifications",
        "chooseCustomers"
      ]
    }
  },
  "events": {
    "updateNotifications": {
      "label": "更新",
      "source": "user",
      "parameters": {
        "enabled": [
          false,
          true
        ]
      }
    }
  },
  "transitions": {
    "updateNotification": {
      "defaultVisible": true,
      "kind": "internal",
      "from": "notificationSettings",
      "to": "notificationSettings",
      "event": "updateNotifications",
      "action": "通知設定を更新する",
      "set": {
        "notificationEnabled": {
          "param": "enabled"
        },
        "notificationOutcome": "updated"
      }
    }
  }
}
