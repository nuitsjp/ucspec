{
  "schemaVersion": "1",
  "name": "顧客管理システム サンプル",
  "repository": "nuitsjp/ucspec",
  "files": [
    "model/*.json",
    "usecases/*.json",
    "checks/*.json"
  ],
  "output": "artifacts/ucspec",
  "initial": [
    {
      "state": "customerManagement",
      "values": {
        "role": "editor"
      }
    },
    {
      "state": "customerManagement",
      "values": {
        "role": "reader"
      }
    },
    {
      "state": "customerManagement",
      "values": {
        "exists": false
      }
    }
  ],
  "limits": {
    "states": 5000,
    "steps": 10,
    "paths": 100000,
    "combinations": 256
  },
  "coverage": {
    "transitions": 100,
    "conditions": 100,
    "multipleConditions": 100
  }
}
