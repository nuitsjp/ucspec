{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ucspec.invalid/spec.schema.json",
  "title": "ucspec structured specification v1",
  "oneOf": [
    {
      "$ref": "#/$defs/project"
    },
    {
      "$ref": "#/$defs/document"
    }
  ],
  "$defs": {
    "target": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "$ref": "#/$defs/decision"
        }
      },
      "additionalProperties": false,
      "description": "アクションと、行き先の状態またはディシジョン。どちらもなければ現在の状態に留まる（開始では不可）。",
      "not": {
        "required": [
          "to",
          "decision"
        ]
      }
    },
    "decision": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "branches": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[^\\s/:>?\\[\\]](?:[^/:>?\\[\\]]*[^\\s/:>?\\[\\]])?$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/target"
          },
          "minProperties": 2
        }
      },
      "additionalProperties": false,
      "required": [
        "branches"
      ],
      "description": "名前付きの分岐。どの分岐を通るかはシナリオが指定する。"
    },
    "event": {
      "type": "object",
      "properties": {
        "actors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s/:>?\\[\\]](?:[^/:>?\\[\\]]*[^\\s/:>?\\[\\]])?$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "defaultVisible": {
          "type": "boolean"
        },
        "action": {
          "type": "string"
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "$ref": "#/$defs/decision"
        }
      },
      "additionalProperties": false,
      "required": [
        "actors"
      ],
      "description": "状態の中で起きるイベント。遷移を兼ねる。",
      "not": {
        "required": [
          "to",
          "decision"
        ]
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "screen": {
          "type": "string",
          "minLength": 1
        },
        "layoutLayer": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "$ref": "#/$defs/target"
        },
        "events": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[^\\s/:>?\\[\\]](?:[^/:>?\\[\\]]*[^\\s/:>?\\[\\]])?$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/event"
          }
        },
        "states": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[^\\s/:>?\\[\\]](?:[^/:>?\\[\\]]*[^\\s/:>?\\[\\]])?$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/state"
          }
        }
      },
      "additionalProperties": false,
      "description": "状態。子状態を持つ状態は開始が必須。"
    },
    "actor": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "pattern": "^[^\\s/:>?\\[\\]](?:[^/:>?\\[\\]]*[^\\s/:>?\\[\\]])?$"
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s/:>?\\[\\]](?:[^/:>?\\[\\]]*[^\\s/:>?\\[\\]])?$"
          }
        },
        "reject": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "event"
      ]
    },
    "scenario": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "goal": {
          "type": "string",
          "pattern": "\\S"
        },
        "expectedOutcome": {
          "type": "string",
          "pattern": "\\S"
        },
        "actor": {
          "type": "string",
          "pattern": "^[^\\s/:>?\\[\\]](?:[^/:>?\\[\\]]*[^\\s/:>?\\[\\]])?$"
        },
        "start": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "goal",
        "expectedOutcome",
        "start",
        "steps"
      ]
    },
    "coverageReview": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "states",
            "compositeStates",
            "transitions",
            "pairs",
            "primePaths",
            "boundedPaths"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "addScenario",
            "represented",
            "forbidden"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        },
        "scenario": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "architectureRequirements": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "basisHash": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "requirements",
        "status",
        "reason",
        "basisHash"
      ],
      "if": {
        "properties": {
          "status": {
            "const": "represented"
          }
        }
      },
      "then": {
        "required": [
          "scenario"
        ]
      }
    },
    "usecasePackage": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "usecase": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "goal": {
          "type": "string",
          "pattern": "\\S"
        },
        "actor": {
          "type": "string",
          "pattern": "^[^\\s/:>?\\[\\]](?:[^/:>?\\[\\]]*[^\\s/:>?\\[\\]])?$"
        },
        "package": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "starts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "ends": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "scenarios": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/scenario"
          }
        },
        "coverageReviews": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/coverageReview"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "goal",
        "actor",
        "starts",
        "ends",
        "scope",
        "scenarios"
      ]
    },
    "commonRule": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ]
    },
    "document": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "start": {
          "$ref": "#/$defs/target"
        },
        "actors": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[^\\s/:>?\\[\\]](?:[^/:>?\\[\\]]*[^\\s/:>?\\[\\]])?$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/actor"
          }
        },
        "events": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[^\\s/:>?\\[\\]](?:[^/:>?\\[\\]]*[^\\s/:>?\\[\\]])?$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/event"
          }
        },
        "states": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[^\\s/:>?\\[\\]](?:[^/:>?\\[\\]]*[^\\s/:>?\\[\\]])?$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/state"
          }
        },
        "usecasePackages": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/usecasePackage"
          }
        },
        "usecases": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/usecase"
          }
        },
        "commonRules": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/commonRule"
          }
        },
        "regressions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/scenario"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "schemaVersion"
      ],
      "description": "仕様ファイル。最上位は名前のないルート状態で、start・events・states はルート状態に属する。"
    },
    "project": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "type": "object",
          "properties": {
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "paths": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000000
            }
          },
          "additionalProperties": false,
          "required": [
            "steps",
            "paths"
          ]
        },
        "coverage": {
          "type": "object",
          "properties": {
            "states": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "compositeStates": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "transitions": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "pairs": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "primePaths": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "boundedPaths": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "name",
        "files",
        "output",
        "limits",
        "coverage"
      ]
    }
  }
}
